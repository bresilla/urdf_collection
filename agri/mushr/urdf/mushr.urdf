<?xml version="1.0"?>
<robot name="mushr_nano">

  <material name="red">
		<color rgba="1 0 0 1" />
	</material>

	<material name="orange">
		<color rgba="1 0.55 0 1" />
	</material>

	<material name="yellow">
		<color rgba="1 1 0 1" />
	</material>

	<material name="green">
		<color rgba="0 1 0 1" />
	</material>

	<material name="blue">
		<color rgba="0 0 1 1" />
	</material>

	<material name="purple">
		<color rgba="0.6 0.2 0.6 1" />
	</material>

	<material name="white">
		<color rgba="1 1 1 1" />
	</material>

	<material name="black">
		<color rgba="0 0 0 1" />
	</material>

	<material name="gold">
		<color rgba="1 0.84 0 1" />
	</material>

	<material name="teal">
		<color rgba="0 0.8 0.8 1" />
	</material>

	<material name="none">
		<color rgba="0 0 0 1" />
	</material>

<link name="base_footprint">
			<inertial>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<mass value="0.1" />
				<inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
			</inertial>
		</link>

		<link name="base_link">
			<inertial>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<mass value="1.0" />
				<inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
			</inertial>
			<visual>
					<origin xyz="0 0 0" rpy="0 0 0" />
					<geometry>
						<mesh filename="package://mushr/meshes/base/nano/mushr_base_nano_core.dae" />
					</geometry>
				</visual>
				<collision>
					<origin xyz="0 0 0" rpy="0 0 0" />
					<geometry>
						<mesh filename="package://mushr/meshes/base/nano/mushr_base_nano_core_collision.dae" />
					</geometry>
				</collision>
			</link>

		<link name="platform_link">
			<inertial>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<mass value="1.0" />
				<inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
			</inertial>
			<visual>
					<origin xyz="0 0 0" rpy="0 0 0" />
					<geometry>
						<mesh filename="package://mushr/meshes/base/nano/mushr_base_nano_platform.stl" />
					</geometry>
					<material name="none" />
				</visual>
				<collision>
					<origin xyz="0 0 0" rpy="0 0 0" />
					<geometry>
						<mesh filename="package://mushr/meshes/base/nano/mushr_base_nano_platform_collision.dae" />
					</geometry>
				</collision>
			</link>

		<link name="insets_link">
			<inertial>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<mass value="1.0" />
				<inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
			</inertial>
			<visual>
					<origin xyz="0 0 0" rpy="0 0 0" />
					<geometry>
						<mesh filename="package://mushr/meshes/base/nano/mushr_base_nano_insets.stl" />
					</geometry>
					<material name="none" />
				</visual>
				<collision>
					<origin xyz="0 0 0" rpy="0 0 0" />
					<geometry>
						<mesh filename="package://mushr/meshes/base/nano/mushr_base_nano_insets_collision.dae" />
					</geometry>
				</collision>
			</link>

		<joint name="base_footprint_to_base_link" type="fixed">
			<origin xyz="0 0 0.094655" rpy="0 0 0" />
			<parent link="base_footprint" />
			<child link="base_link" />
		</joint>

		<joint name="base_link_to_platform_link" type="fixed">
			<origin xyz="0 0 0.0" rpy="0 0 0" />
			<parent link="base_link" />
			<child link="platform_link" />
		</joint>

		<joint name="base_link_to_insets_link" type="fixed">
			<origin xyz="0 0 0.0" rpy="0 0 0" />
			<parent link="base_link" />
			<child link="insets_link" />
		</joint>

	<link name="front_left/wheel_link">
                        <inertial>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<mass value="1.0" />
                                <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
                        </inertial>

                        <visual>

				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
                                        <mesh filename="package://mushr/meshes/base/mushr_wheel.dae" />
                                </geometry>
                        </visual>
                        <collision>
				<origin xyz="0 0 0" rpy="0 0 3.141592" />
				<geometry>
                                        <mesh filename="package://mushr/meshes/base/mushr_wheel_collision.dae" />
                                </geometry>
                        </collision>
                </link>
        <link name="front_right/wheel_link">
                        <inertial>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<mass value="1.0" />
                                <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
                        </inertial>

                        <visual>

				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
                                        <mesh filename="package://mushr/meshes/base/mushr_wheel.dae" />
                                </geometry>
                        </visual>
                        <collision>
				<origin xyz="0 0 0" rpy="0 0 3.141592" />
				<geometry>
                                        <mesh filename="package://mushr/meshes/base/mushr_wheel_collision.dae" />
                                </geometry>
                        </collision>
                </link>
        <link name="back_left/wheel_link">
                        <inertial>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<mass value="1.0" />
                                <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
                        </inertial>

                        <visual>

				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
                                        <mesh filename="package://mushr/meshes/base/mushr_wheel.dae" />
                                </geometry>
                        </visual>
                        <collision>
				<origin xyz="0 0 0" rpy="0 0 3.141592" />
				<geometry>
                                        <mesh filename="package://mushr/meshes/base/mushr_wheel_collision.dae" />
                                </geometry>
                        </collision>
                </link>
        <link name="back_right/wheel_link">
                        <inertial>
				<origin xyz="0 0 0" rpy="0 0 0" />
				<mass value="1.0" />
                                <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
                        </inertial>

                        <visual>

				<origin xyz="0 0 0" rpy="0 0 0" />
				<geometry>
                                        <mesh filename="package://mushr/meshes/base/mushr_wheel.dae" />
                                </geometry>
                        </visual>
                        <collision>
				<origin xyz="0 0 0" rpy="0 0 3.141592" />
				<geometry>
                                        <mesh filename="package://mushr/meshes/base/mushr_wheel_collision.dae" />
                                </geometry>
                        </collision>
                </link>
        <link name="laser_link">
                        <inertial>
                                <origin xyz="0 0 0" rpy="0 0 0" />
                                <mass value="1.0" />
                                <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
                        </inertial>

                        <visual>
                                <origin xyz="0 0 0" rpy="0 0 0" />
                                <geometry>
                                        <mesh filename="package://mushr/meshes/sensors/mushr_ydlidar.dae" />
                                </geometry>
                        </visual>
                        <collision>
                                <origin xyz="0 0 0" rpy="0 0 0" />
                                <geometry>
                                        <mesh filename="package://mushr/meshes/sensors/mushr_ydlidar_collision.dae" />
                                </geometry>
                        </collision>
                </link>
        <link name="front_left/wheel_steer_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />

      <mass value="0.001" />
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
    </inertial>
  </link>

  <link name="front_right/wheel_steer_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />

      <mass value="0.001" />
      <inertia ixx="1" ixy="0" ixz="0" iyy="1" iyz="0" izz="1" />
    </inertial>
  </link>

  <joint name="front_left_wheel_steer" type="revolute">
		<axis xyz="0 0 1" />
		<limit effort="1000.0" lower="-1.57" upper="1.57" velocity="10.0" />
    <origin xyz="0.1385 0.115 -0.045855" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_left/wheel_steer_link" />
	</joint>


	<joint name="front_right_wheel_steer" type="revolute">
		<axis xyz="0 0 1" />
		<limit effort="1000.0" lower="-1.57" upper="1.57" velocity="10.0" />
    <origin xyz="0.1385 -0.115 -0.045855" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="front_right/wheel_steer_link" />
	</joint>

  <joint name="front_left_wheel_throttle" type="continuous">
		<axis xyz="0 1 0" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="front_left/wheel_steer_link" />
    <child link="front_left/wheel_link" />
	</joint>


  <joint name="front_right_wheel_throttle" type="continuous">
		<axis xyz="0 1 0" />
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="front_right/wheel_steer_link" />
    <child link="front_right/wheel_link" />
	</joint>

  <joint name="back_left_wheel_throttle" type="continuous">
		<axis xyz="0 1 0" />
    <origin xyz="-0.158 0.115 -0.045855" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="back_left/wheel_link" />
	</joint>

  <joint name="back_right_wheel_throttle" type="continuous">
		<axis xyz="0 1 0" />
    <origin xyz="-0.158 -0.115 -0.045855" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="back_right/wheel_link" />
	</joint>

	<joint name="base_link_to_laser_link" type="fixed">
		<origin xyz="-0.035325 0 0.10775" rpy="0 0 0" />
		<parent link="base_link" />
		<child link="laser_link" />
	</joint>
</robot>
