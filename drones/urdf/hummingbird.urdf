<?xml version="1.0"?>
<!-- hummingbird: body + rotors from RotorS (arm lengths per-drone matching rotors_description xacro) -->
<robot name="hummingbird">
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/hummingbird.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/hummingbird.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <link name="rotor_0_front">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/propeller_cw.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_0_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_0_front"/>
    <origin rpy="0 0 0" xyz="0.17 0.0 0.01"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_1_left">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_1_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_1_left"/>
    <origin rpy="0 0 0" xyz="0.0 0.17 0.01"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_2_back">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/propeller_cw.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_2_back_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_2_back"/>
    <origin rpy="0 0 0" xyz="-0.17 0.0 0.01"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_3_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_3_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_3_right"/>
    <origin rpy="0 0 0" xyz="0.0 -0.17 0.01"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
