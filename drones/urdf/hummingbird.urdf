<?xml version="1.0"?>
<!-- hummingbird: body mesh from RotorS (ethz-asl/rotors_simulator) -->
<robot name="hummingbird">
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/hummingbird.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/hummingbird.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
</robot>
