<?xml version="1.0"?>
<!-- iris: body + rotors from RotorS (arm lengths per-drone matching rotors_description xacro) -->
<robot name="iris">
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="-0.0017189999999999942 -0.006611000000000004 0.010137000000000004"/>
      <geometry>
        <mesh filename="package://drones/meshes/iris.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/iris.dae" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <link name="rotor_0_front_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_0_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_0_front_right"/>
    <origin rpy="0 0 0" xyz="0.13 -0.22 0.023"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_1_back_left">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/propeller_ccw.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_1_back_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_1_back_left"/>
    <origin rpy="0 0 0" xyz="-0.13 0.2 0.023"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_2_front_left">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/propeller_cw.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_2_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_2_front_left"/>
    <origin rpy="0 0 0" xyz="0.13 0.22 0.023"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_3_back_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/propeller_cw.dae" scale="0.1 0.1 0.1"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_3_back_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_3_back_right"/>
    <origin rpy="0 0 0" xyz="-0.13 -0.2 0.023"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
