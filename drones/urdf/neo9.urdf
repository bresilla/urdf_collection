<?xml version="1.0"?>
<!-- neo9: body + rotors from RotorS (arm lengths per-drone matching rotors_description xacro) -->
<robot name="neo9">
  <link name="base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/neo9.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/neo9.dae" scale="1 1 1"/>
      </geometry>
    </collision>
  </link>
  <link name="rotor_0_front">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/neo9_propeller_cw.dae" scale="0.1143 0.1143 0.1143"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_0_front_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_0_front"/>
    <origin rpy="0 0 0" xyz="0.2495 0.0 0.028"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_1_left">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/neo9_propeller_ccw.dae" scale="0.1143 0.1143 0.1143"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_1_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_1_left"/>
    <origin rpy="0 0 0" xyz="0.0 0.2495 0.028"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_2_back">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/neo9_propeller_cw.dae" scale="0.1143 0.1143 0.1143"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_2_back_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_2_back"/>
    <origin rpy="0 0 0" xyz="-0.2495 0.0 0.028"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="rotor_3_right">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://drones/meshes/neo9_propeller_ccw.dae" scale="0.1143 0.1143 0.1143"/>
      </geometry>
    </visual>
  </link>
  <joint name="rotor_3_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rotor_3_right"/>
    <origin rpy="0 0 0" xyz="0.0 -0.2495 0.028"/>
    <axis xyz="0 0 1"/>
  </joint>
</robot>
